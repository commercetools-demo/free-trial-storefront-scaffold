# ---------------------------------------------------------------------------
# commercetools API client (server-only — never use a NEXT_PUBLIC_ prefix)
# Create an API client in Merchant Center → Settings → Developer Settings,
# using the "Frontend B2B" scope template, then ensure manage_sessions and
# manage_orders are included.
# ---------------------------------------------------------------------------
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_SCOPES=manage_sessions:your-project-key manage_orders:your-project-key

# Region auth/API URLs — pick the pair that matches your project's region.
#   Americas (GCP):   https://auth.us-central1.gcp.commercetools.com
#                     https://api.us-central1.gcp.commercetools.com
#   Europe (GCP):     https://auth.europe-west1.gcp.commercetools.com
#                     https://api.europe-west1.gcp.commercetools.com
#   Australia (GCP):  https://auth.australia-southeast1.gcp.commercetools.com
#                     https://api.australia-southeast1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# ---------------------------------------------------------------------------
# Session signing secret — must be a strong, server-only value (>= 32 chars).
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-strong-random-32-char-minimum-secret

# ---------------------------------------------------------------------------
# commercetools Checkout (payment-only / paymentFlow) — Merchant Center →
# Checkout → Applications. The key of your Checkout Application. Region and
# projectKey are derived server-side from CTP_API_URL — no public vars needed.
# ---------------------------------------------------------------------------
CTP_CHECKOUT_APP_KEY=your-checkout-application-key
